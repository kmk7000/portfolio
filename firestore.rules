rules_version = '2';

// 방명록(What friends say)과 낙서장(오에카키)입니다.
// - 누구나 읽을 수 있습니다.
// - 쓰기는 익명 로그인한 방문자만, 정해진 칸과 글자 수로만 할 수 있습니다.
// - 고치기는 없고, 지우기는 쓴 사람(같은 브라우저)만 할 수 있습니다.
//   글/그림을 쓴 사람은 그 아래 달린 댓글도 함께 지울 수 있습니다.
// - 주인장(아래 두 구글 계정)은 사이트 내용(site/content)과 사진(images)을 고치고,
//   누구의 글·그림이든 지우거나 그림을 가릴(hidden) 수 있습니다.
//   원본은 "먼저 등록한 사람이 주인" 이지만, 여기서는 정해 둔 계정만 주인장이 됩니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['milk45453@gmail.com', 'milk454537@gmail.com'];
    }

    function data() {
      return request.resource.data;
    }

    // 새 문서가 정확히 이 칸들만 가졌고, 쓴 사람이 나이며, 시각이 서버 시각인지
    function ownNew(fields) {
      return signedIn()
        && data().keys().hasOnly(fields)
        && data().keys().hasAll(fields)
        && data().uid == request.auth.uid
        && data().createdAt == request.time;
    }

    function text(value, max) {
      return value is string && value.trim().size() > 0 && value.size() <= max;
    }

    function optionalText(value, max) {
      return value is string && value.size() <= max;
    }

    function mine() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function mineOrOwner() {
      return mine() || isOwner();
    }

    function doc(path) {
      return /databases/$(database)/documents/$(path);
    }

    // 주인장이 고치는 사이트 내용입니다. 문서가 없으면 화면은 코드(src/config)의 값을 씁니다.
    match /site/content {
      allow read: if true;
      allow create, update: if isOwner()
        && data().keys().hasOnly(['profile', 'tabs', 'blocks', 'waveLinks', 'furniture', 'updatedAt']);
      allow delete: if false;
    }

    // 주인장이 올린 사진입니다. 문서 1MB 제한 안에서 압축한 data URL 한 장씩 담습니다.
    match /images/{id} {
      allow read: if true;
      allow create: if isOwner()
        && data().keys().hasOnly(['dataUrl'])
        && data().dataUrl is string
        && data().dataUrl.size() <= 900000
        && data().dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+');
      allow update: if false;
      allow delete: if isOwner();
    }

    match /guestbook/{id} {
      allow read: if true;
      allow create: if ownNew(['author', 'text', 'uid', 'createdAt'])
        && text(data().author, 20)
        && text(data().text, 100);
      allow update: if false;
      allow delete: if mineOrOwner();
    }

    match /guestbookReplies/{id} {
      allow read: if true;
      allow create: if ownNew(['entryId', 'author', 'text', 'uid', 'createdAt'])
        && data().entryId is string
        && exists(doc(/guestbook/$(data().entryId)))
        && text(data().author, 20)
        && text(data().text, 100);
      allow update: if false;
      allow delete: if mineOrOwner()
        || (signedIn() && get(doc(/guestbook/$(resource.data.entryId))).data.uid == request.auth.uid);
    }

    // 가려진(hidden) 그림은 주인장만 봅니다. 그래서 방문자 목록은 hidden == false 로 거릅니다.
    match /oekaki/{id} {
      allow read: if resource.data.hidden == false || isOwner();
      allow create: if ownNew(['author', 'comment', 'image', 'hasReplay', 'hidden', 'uid', 'createdAt'])
        && data().hidden == false
        && text(data().author, 20)
        && optionalText(data().comment, 60)
        && data().image is string
        && data().image.size() <= 300000
        && data().image.matches('data:image/png;base64,[A-Za-z0-9+/=]+')
        && data().hasReplay is bool;
      // 가림 처리: 주인장만, hidden 한 칸만
      allow update: if isOwner()
        && data().diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && data().hidden is bool;
      allow delete: if mineOrOwner();
    }

    // 그리는 과정 기록은 커서 목록과 따로 둡니다. 그림을 열어 재생할 때만 읽습니다.
    // 문서 id 는 그림 id 와 같고, 그림과 한 번에(batch) 만듭니다.
    match /oekakiReplays/{id} {
      allow read: if isOwner() || get(doc(/oekaki/$(id))).data.hidden == false;
      allow create: if signedIn()
        && data().keys().hasOnly(['replay', 'uid'])
        && data().keys().hasAll(['replay', 'uid'])
        && data().uid == request.auth.uid
        && data().replay is string
        && data().replay.size() <= 400000
        && getAfter(doc(/oekaki/$(id))).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if mineOrOwner();
    }

    match /oekakiReplies/{id} {
      allow read: if true;
      allow create: if ownNew(['drawingId', 'author', 'text', 'uid', 'createdAt'])
        && data().drawingId is string
        && exists(doc(/oekaki/$(data().drawingId)))
        && text(data().author, 20)
        && text(data().text, 100);
      allow update: if false;
      allow delete: if mineOrOwner()
        || (signedIn() && get(doc(/oekaki/$(resource.data.drawingId))).data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
