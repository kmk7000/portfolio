rules_version = '2';

// 방명록(What friends say)과 낙서장(오에카키)입니다.
// - 누구나 읽을 수 있습니다.
// - 쓰기는 익명 로그인한 방문자만, 정해진 칸과 글자 수로만 할 수 있습니다.
// - 고치기는 없고, 지우기는 쓴 사람(같은 브라우저)만 할 수 있습니다.
//   글/그림을 쓴 사람은 그 아래 달린 댓글도 함께 지울 수 있습니다.
// - 사이트 주인은 Firebase 콘솔에서 무엇이든 지울 수 있습니다(콘솔은 이 규칙을 거치지 않습니다).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function data() {
      return request.resource.data;
    }

    // 새 문서가 정확히 이 칸들만 가졌고, 쓴 사람이 나이며, 시각이 서버 시각인지
    function ownNew(fields) {
      return signedIn()
        && data().keys().hasOnly(fields)
        && data().keys().hasAll(fields)
        && data().uid == request.auth.uid
        && data().createdAt == request.time;
    }

    function text(value, max) {
      return value is string && value.trim().size() > 0 && value.size() <= max;
    }

    function optionalText(value, max) {
      return value is string && value.size() <= max;
    }

    function mine() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function doc(path) {
      return /databases/$(database)/documents/$(path);
    }

    match /guestbook/{id} {
      allow read: if true;
      allow create: if ownNew(['author', 'text', 'uid', 'createdAt'])
        && text(data().author, 20)
        && text(data().text, 100);
      allow update: if false;
      allow delete: if mine();
    }

    match /guestbookReplies/{id} {
      allow read: if true;
      allow create: if ownNew(['entryId', 'author', 'text', 'uid', 'createdAt'])
        && data().entryId is string
        && exists(doc(/guestbook/$(data().entryId)))
        && text(data().author, 20)
        && text(data().text, 100);
      allow update: if false;
      allow delete: if mine()
        || (signedIn() && get(doc(/guestbook/$(resource.data.entryId))).data.uid == request.auth.uid);
    }

    match /oekaki/{id} {
      allow read: if true;
      allow create: if ownNew(['author', 'comment', 'image', 'hasReplay', 'uid', 'createdAt'])
        && text(data().author, 20)
        && optionalText(data().comment, 60)
        && data().image is string
        && data().image.size() <= 300000
        && data().image.matches('data:image/png;base64,[A-Za-z0-9+/=]+')
        && data().hasReplay is bool;
      allow update: if false;
      allow delete: if mine();
    }

    // 그리는 과정 기록은 커서 목록과 따로 둡니다. 그림을 열어 재생할 때만 읽습니다.
    // 문서 id 는 그림 id 와 같고, 그림과 한 번에(batch) 만듭니다.
    match /oekakiReplays/{id} {
      allow read: if true;
      allow create: if signedIn()
        && data().keys().hasOnly(['replay', 'uid'])
        && data().keys().hasAll(['replay', 'uid'])
        && data().uid == request.auth.uid
        && data().replay is string
        && data().replay.size() <= 400000
        && getAfter(doc(/oekaki/$(id))).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if mine();
    }

    match /oekakiReplies/{id} {
      allow read: if true;
      allow create: if ownNew(['drawingId', 'author', 'text', 'uid', 'createdAt'])
        && data().drawingId is string
        && exists(doc(/oekaki/$(data().drawingId)))
        && text(data().author, 20)
        && text(data().text, 100);
      allow update: if false;
      allow delete: if mine()
        || (signedIn() && get(doc(/oekaki/$(resource.data.drawingId))).data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
